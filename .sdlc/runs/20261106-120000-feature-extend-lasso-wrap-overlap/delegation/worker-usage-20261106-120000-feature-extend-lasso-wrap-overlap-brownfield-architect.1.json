        "name": "header.json",
        "section_json": "{\n  \"conventions\": [\n    \"Format code with Prettier (@excalidraw/prettier-config: double quotes, semicolons, 2-space indent, trailing commas).\",\n    \"Group imports with blank lines between external packages, internal @excalidraw/* workspace packages, relative imports, and type-only imports.\",\n    \"Use Vitest (describe/it/expect) with ./test-utils (render, act, assertSelectedElements) and window.h harness in packages/excalidraw/tests/*.test.tsx.\",\n    \"Keep strict TypeScript compliance without any or ts-ignore.\"\n  ],\n  \"decisions\": [\n    {\n      \"topic\": \"getLassoSelectedElementIds mode parameter and default\",\n      \"choice\": \"Accept optional boxSelectionMode?: BoxSelectionMode defaulting to \\\"contain\\\" on getLassoSelectedElementIds input, and pass this.app.state.boxSelectionMode from LassoTrail.updateSelection\",\n      \"rejected\": [\n        \"Defaulting boxSelectionMode to \\\"overlap\\\" in getLassoSelectedElementIds\",\n        \"Reading window.h.state directly inside getLassoSelectedElementIds\"\n      ],\n      \"reason\": \"Aligns getLassoSelectedElementIds with getElementsWithinSelection (which defaults boxSelectionMode to \\\"contain\\\") while keeping utils.ts pure and testable.\"\n    },\n    {\n      \"topic\": \"Full outline containment in Wrap (\\\"contain\\\") mode\",\n      \"choice\": \"Require every segment endpoint of the element outline (and its positioned bound text outline if present) to lie inside the closed lasso polygon via polygonIncludesPointNonZero AND require intersectionTest(path, element, elementsMap, segments) to be false, while skipping standalone bound text elements\",\n      \"rejected\": [\n        \"Testing only element AABB corners against the lasso polygon\",\n        \"Testing only segment points without checking lasso edge intersections\"\n      ],\n      \"reason\": \"AABB-only checks fail on rounded corners, diamonds, ellipses, rotated shapes, lines, and freedraw strokes, while point-only checks miss concave lasso edges cutting across straight sides between enclosed vertices"
